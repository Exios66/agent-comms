# pglite | supabase
HUB_BACKEND=pglite

# Local dashboard + MCP HTTP hub
HUB_URL=http://127.0.0.1:3000
HUB_DATA_DIR=.data/hub

# Seeded local agents (never use these in production)
# alpha / workstation  →  alpha-dev-token
# bravo / laptop       →  bravo-dev-token
HUB_AGENT_TOKEN=alpha-dev-token

# Hosted Supabase (required when HUB_BACKEND=supabase)
# Never put the service_role key in the browser, MCP clients, or this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: agent JWT for MCP when talking to hosted Supabase
SUPABASE_AGENT_JWT=
