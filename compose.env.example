# Copy to compose.env and adjust. Docker Compose loads this automatically
# when you use scripts/docker-compose.sh or pnpm docker:* (see README).

# Enable the public quick-tunnel profile (hub + cloudflared).
# Omit or leave empty for local-only hub on http://localhost:3000
COMPOSE_PROFILES=public

# Optional project name (shows in `docker ps`)
COMPOSE_PROJECT_NAME=agent-comms

# Host port for the dashboard and /api/hub
HUB_PORT=3000

# Optional: set after first `pnpm docker:public` once you know the trycloudflare URL.
# Improves Agent Card links when not using forwarded Host headers.
# HUB_PUBLIC_URL=https://example.trycloudflare.com
